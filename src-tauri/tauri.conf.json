{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dynamis",
  "version": "0.5.2",
  "identifier": "com.anstercharles.dynamis",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dynamis",
        "width": 1080,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "backgroundColor": "#eceae4"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Anster Charles",
    "copyright": "© 2026 Anster Charles",
    "category": "Utility",
    "shortDescription": "Force meter for a thin-film force sensor on an Arduino Uno",
    "longDescription": "Plug in an Arduino Uno with a thin-film force sensor on A0 and Dynamis installs its own firmware, connects and shows live force, peak and a graph, with calibration and CSV recording.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
